{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Chain height",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "ethereum_blockchain_height", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Peers",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "ethereum_peer_count", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Indexer lag (blocks)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "indexer_lag_blocks", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "API up",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"api\"}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Block height",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "ethereum_blockchain_height", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Besu JVM memory",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jvm_memory_bytes_used", "refId": "A", "legendFormat": "{{area}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "API request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (route) (rate(http_requests_total[1m]))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Indexer blocks processed",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(indexer_blocks_processed_total[1m])", "refId": "A" }]
    }
  ],
  "schemaVersion": 39,
  "tags": ["besu"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Besu Enterprise Network",
  "uid": "besu-enterprise",
  "version": 1
}
