# ---------------------------------------------------------------------------
# Besu Enterprise Network — environment template
# Copy to .env and adjust. NEVER commit a real .env file.
# All keys/passwords below are development-only placeholders.
# ---------------------------------------------------------------------------

# --- Blockchain -------------------------------------------------------------
CHAIN_ID=7117
NETWORK_NAME="Enterprise Besu Network"
# JSON-RPC exposed by validator-1 in docker-compose (local dev only)
RPC_URL=http://localhost:8545
WS_RPC_URL=ws://localhost:8546
# Besu docker image (pin for reproducible builds)
BESU_IMAGE=hyperledger/besu:26.9.0

# --- Deployer / write account -----------------------------------------------
# Well-known Hyperledger Besu *development* account, prefunded in the dev genesis.
# Address: 0xfe3b557e8fb62b89f4916b721be55ceb828dbd73
# Replace with a securely generated key (never committed) for staging/production.
DEPLOYER_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63

# --- Contract addresses (filled by `npm run contracts:deploy`) --------------
TOKEN_CONTRACT_ADDRESS=
ASSET_REGISTRY_ADDRESS=
PERMISSIONED_TRANSFER_ADDRESS=
# Block at which contracts were deployed (lets the indexer skip earlier blocks for logs)
CONTRACTS_DEPLOY_BLOCK=0

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=besu
POSTGRES_PASSWORD=besu_dev_password
POSTGRES_DB=besu_network
POSTGRES_PORT=5433
DATABASE_URL=postgresql://besu:besu_dev_password@localhost:5433/besu_network

# --- API --------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Shared secret required (X-API-Key header) for state-changing POST endpoints
API_WRITE_KEY=dev-write-key-change-me
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
# Number of confirmations before a transaction is reported as CONFIRMED
TX_CONFIRMATIONS=2
TX_TIMEOUT_MS=60000

# --- Indexer ----------------------------------------------------------------
INDEXER_START_BLOCK=0
INDEXER_POLL_INTERVAL_MS=1000
INDEXER_BATCH_SIZE=25
INDEXER_METRICS_PORT=4100

# --- Frontend ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3001
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_NETWORK_NAME="Enterprise Besu Network"

# --- Monitoring -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_password
GRAFANA_PORT=3300
PROMETHEUS_PORT=9090
