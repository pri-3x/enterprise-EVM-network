{
  "name": "@besu-net/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Restart-safe block and event indexer from Besu into PostgreSQL",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@besu-net/db": "*",
    "@besu-net/shared": "*",
    "drizzle-orm": "^0.45.3",
    "ethers": "^6.13.5",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
